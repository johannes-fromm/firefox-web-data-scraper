{
  "manifest_version": 3,
  "name": "Instant Data Scraper",
  "version": "1.0.0",
  "description": "Extrahiert strukturierte Daten aus Webseiten und exportiert sie als CSV oder Excel-kompatible Datei.",
  "permissions": [
    "activeTab",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Instant Data Scraper",
    "default_popup": "popup.html"
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "instant-data-scraper@example.com",
      "strict_min_version": "109.0"
    }
  }
}
